{
    // EASI-PASS — start here. Copy, edit the paths, run:
    //   python master_pipeline.py --manifest your_file.hjson
    //
    // Inputs:  {base_path}/{sample_name}/2P/plane_{N}.tiff
    //          {base_path}/{sample_name}/HCR/HCR{R}.tiff   (one per round)
    //
    // Add --check_alignment to stop after matching 2P to the reference round;
    // later rounds need not exist yet. Re-run without it to finish.
    //
    // Hi-res bridge: drop a stitched plane_{N}_hires.tiff next to plane_{N}.tiff.
    // Single round: leave one entry in `rounds`. Neither needs a manifest change.
    //
    // All tunable parameters are documented in param_example.hjson.

    data: {
        base_path: "/path/to/your/data"     // the folder that contains {sample_name}/
        sample_name: "MOUSE001"

        two_photon_imaging: {
            sessions: [
                {
                    input_format: "tiff"
                    functional_planes: ["0"]
                }
            ]
        }

        HCR_confocal_imaging: {
            rounds: [
                {
                    round: "01"
                    channels: ["DAPI", "PROBE_A", "PROBE_B"]   // DAPI must be first
                    resolution: [1.515, 1.515, 5.0]            // x, y, z microns per voxel
                }
                {
                    round: "02"
                    channels: ["DAPI", "PROBE_C", "PROBE_D"]
                    resolution: [1.515, 1.515, 5.0]
                }
            ]
            reference_round: "01"
        }
    }

    params: {
        // The global/local blocks are required whenever there is more than one round.
        HCR_to_HCR_registration: {
            downsampling: [3, 3, 2]
            global: {
                context_radius_um: [40, 60, 80]   // all searched; best auto-picked
                match_threshold: 0.3              // lower to 0.2 if rounds register poorly
                select_metric: "mi"
            }
            local: {
                blocksize: [[200, 200, 10]]
                overlap: 0.5
                context_radius: [12, 12, 2]
                match_threshold: 0.3
                // How far a cell may have moved between rounds. Too low and every
                // candidate pair in a block is rejected, the block quietly falls back
                // to no correction. Keep it under blocksize_xy * um-per-px.
                max_spot_match_distance_um: 200
                count_floor: 8
                match_floor: 4
                adaptive_edges: true
            }
        }

        // Coarse 2P orientation relative to the FISH volume, applied before landmarks.
        rotation_2p_to_HCR: { rotation: 0, fliplr: false, flipud: false }

        twop_to_hcr_registration: {
            cascade_stages: [300, 100, 50]   // local tile sizes, px
        }

        // "cpsam" is cellpose-SAM, downloaded on first run. Or give a path to your own model.
        // gpu: true means "use an accelerator if there is one" -- it is not a requirement.
        // Without a GPU this still runs, just slower; set false to pin it to the CPU.
        // Already have masks? See "Bringing your own masks" in the README to skip cellpose.
        HCR_cellpose: {
            model_path: "cpsam"
            cellpose_channel: 0
            diameter: 15          // px
            gpu: true
            flow_threshold: 0.5
            cellprob_threshold: -0.5
        }

        2p_cellpose: {
            model_path: "cpsam"
            cellpose_channel: 0
            diameter: 7
            gpu: true
            flow_threshold: 0
            cellprob_threshold: -1
        }

        intensity_extraction: {
            neuropil_radius: 50
            neuropil_boundary: 1
            neuropil_pooling: ["mean", "median", "percentile-20"]
            stack_median_filter: [3, 3, 3]
        }
    }
}
