{
    // EASI-PASS — FISH rounds only, no functional data. Copy, edit the paths, run:
    //   python master_pipeline.py --manifest your_file.hjson
    //
    // Inputs:  {base_path}/{sample_name}/HCR/HCR{R}.tiff   (one per round)
    //
    // Rounds are registered to the reference, segmented, and matched to each other.
    // With no two_photon_imaging section, --only_hcr is inferred.

    data: {
        base_path: "/path/to/your/data"     // the folder that contains {sample_name}/
        sample_name: "MOUSE001"

        HCR_confocal_imaging: {
            rounds: [
                {
                    round: "01"
                    channels: ["DAPI", "PROBE_A", "PROBE_B"]   // DAPI must be first
                    // Optional, and only a fallback. The volume's own calibration is read
                    // from the file and always wins; this is used when the file has none.
                    resolution: [1.515, 1.515, 5.0]            // x, y, z microns per voxel
                }
                {
                    round: "02"
                    channels: ["DAPI", "PROBE_C", "PROBE_D"]
                    resolution: [1.515, 1.515, 5.0]
                }
                {
                    round: "03"
                    channels: ["DAPI", "PROBE_E", "PROBE_F"]
                    resolution: [1.515, 1.515, 5.0]
                }
            ]

            reference_round: "01"
        }
    }

    params: {
        // The global/local blocks are required whenever there is more than one round.
        HCR_to_HCR_registration: {
            downsampling: [3, 3, 2]
            global: {
                context_radius_um: [40, 60, 80]   // all searched; best auto-picked
                match_threshold: 0.3              // lower to 0.2 if rounds register poorly
                select_metric: "mi"

                // ROTATION RESCUE -- off by default, uncomment to enable.
                // The matcher correlates AXIS-ALIGNED patches and has no rotation invariance,
                // and the QC test only tries 0/90/180/270. A round mounted a few degrees off
                // therefore degrades silently and stops registering somewhere past 5-8 deg.
                // Turn this on when a round fails and its overlay looks slightly rotated.
                // angle_search_deg: 15           // half-span: scans -15..+15. 0 = off
                // angle_step_deg: 5              // step within the span
                // angle_scan_radius_um: 80       // default: the largest context_radius_um
                // angle_keep_zero_margin: 2.0    // a non-zero angle must beat 0 deg by this
                                                  // factor before it is taken, so a healthy
                                                  // round stays at 0 and the scan is a rescue
                                                  // and not a re-optimisation. Measured on 10
                                                  // rounds across 5 samples; do not lower it
                                                  // without re-running that sweep.
            }
            local: {
                blocksize: [[200, 200, 10]]
                overlap: 0.5
                context_radius: [12, 12, 2]
                match_threshold: 0.3
                // How far a cell may have moved between rounds. Too low and every
                // candidate pair in a block is rejected, the block quietly falls back
                // to no correction. Keep it under blocksize_xy * um-per-px.
                max_spot_match_distance_um: 200
                count_floor: 8
                match_floor: 4
                adaptive_edges: true
            }
        }

        // "cpsam" is cellpose-SAM, downloaded on first run. Or give a path to your own model.
        HCR_cellpose: {
            model_path: "cpsam"
            cellpose_channel: 0
            diameter: 15          // px
            // "use an accelerator if there is one", not a requirement. Without a GPU this
            // still runs, just slower; set false to pin it to the CPU. Already have masks?
            // See docs/masks.md to skip cellpose entirely.
            gpu: true
            flow_threshold: 0.5
            cellprob_threshold: -0.5
        }

        intensity_extraction: {
            neuropil_radius: 50
            neuropil_boundary: 1
            neuropil_pooling: ["mean", "median", "percentile-20"]
            stack_median_filter: [3, 3, 3]
        }
    }
}
