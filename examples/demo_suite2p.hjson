{
    // EASI-PASS — reading the 2P mean image from an existing Suite2p folder.
    // Otherwise identical to demo_tiff.hjson.
    //
    // Inputs:  {base_path}/{mouse_name}/2P/suite2p/plane{N}/ops.npy   (meanImg is read)
    //          {base_path}/{mouse_name}/HCR/{mouse_name}_HCR{R}.tiff  (one per round)
    //
    // Note Suite2p's folder is plane{N}; the tiff path uses plane_{N}.tiff.

    data: {
        base_path: "/mnt/nasquatch/data/2p/YOUR_LAB/EASI_FISH/pipeline"
        mouse_name: "MOUSE001"

        two_photon_imaging: {
            sessions: [
                {
                    input_format: "suite2p"
                    functional_planes: ["0"]
                }
            ]
        }

        HCR_confocal_imaging: {
            rounds: [
                {
                    round: "01"
                    channels: ["DAPI", "PROBE_A", "PROBE_B"]   // DAPI must be first
                    resolution: [1.515, 1.515, 5.0]            // x, y, z microns per voxel
                }
                {
                    round: "02"
                    channels: ["DAPI", "PROBE_C", "PROBE_D"]
                    resolution: [1.515, 1.515, 5.0]
                }
            ]
            reference_round: "01"
        }
    }

    params: {
        // The global/local blocks are required whenever there is more than one round.
        HCR_to_HCR_registration: {
            downsampling: [3, 3, 2]
            global: {
                context_radius_um: [40, 60, 80]   // all searched; best auto-picked
                match_threshold: 0.3              // lower to 0.2 if rounds register poorly
                select_metric: "mi"
            }
            local: {
                blocksize: [[200, 200, 10]]
                overlap: 0.5
                context_radius: [12, 12, 2]
                match_threshold: 0.3
                max_spot_match_distance_um: 60
                count_floor: 8
                match_floor: 4
                adaptive_edges: true
            }
        }

        // Coarse 2P orientation relative to the FISH volume, applied before landmarks.
        rotation_2p_to_HCR: { rotation: 0, fliplr: false, flipud: false }

        twop_to_hcr_registration: {
            cascade_stages: [300, 100, 50]   // local tile sizes, px
        }

        // "cpsam" is cellpose-SAM, downloaded on first run. Or give a path to your own model.
        HCR_cellpose: {
            model_path: "cpsam"
            cellpose_channel: 0
            diameter: 15          // px
            gpu: true
            flow_threshold: 0.5
            cellprob_threshold: -0.5
        }

        2p_cellpose: {
            model_path: "cpsam"
            cellpose_channel: 0
            diameter: 7
            gpu: true
            flow_threshold: 0
            cellprob_threshold: -1
        }

        intensity_extraction: {
            neuropil_radius: 50
            neuropil_boundary: 1
            neuropil_pooling: ["mean", "median", "percentile-20"]
            stack_median_filter: [3, 3, 3]
        }
    }
}
