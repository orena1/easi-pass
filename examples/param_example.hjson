// ===== HCR round-to-round registration =====
// A `global` and `local` block are REQUIRED for multi-round manifests. With them the
// pipeline computes the registration IN-PROCESS using cellpose nucleus centroids, shows a
// ranked review, and on your selection WRITES HCR_selected_registrations below for you.
// Omitting them falls back to a legacy notebook workflow that is not part of this release,
// and the pipeline raises rather than silently dropping every non-reference round.
HCR_to_HCR_registration:{
    "downsampling":[3, 3, 2]            // [x,y,z] downsample for the global (lowres) stage

    "global":{
        "context_radius_um":[40, 60, 80]  // searched (downsampled, cheap); best auto-picked. ~60um is near-universal
        "match_threshold":0.3          // context-correlation cutoff for a centroid match
        "select_metric":"mi"           // pick best radius: "mi" (default) | "median_resid" | "above_chance" (all guarded vs worse-than-chance)
        // no rotation cap: the RANSAC affine is used as-is
    }
    "local":{
        "blocksize":[[200,200,10]]     // fixed winner (cortex+PBN screen); add more here to search if tissue differs
        "overlap":0.5
        "context_radius":[12, 12, 2]   // block context window in VOXELS (current local style)
        // "context_radius_um":60       // OPT-IN: use a um-window for blocks instead (experiment)
        "match_threshold":0.3
        "max_spot_match_distance_um":200 // cap on how far a cell may have moved between rounds.
                                       // Set below the real displacement and every candidate pair
                                       // in a block is rejected: the block falls back to no
                                       // correction, silently. Keep it <= blocksize_xy * um-per-px
                                       // (200px at 1.26um/px reaches ~126um), since a larger cap
                                       // only adds rival candidates the block cannot act on.
        "count_floor":8                // minimum centroids per block
        "match_floor":4                // minimum point matches per block
        "adaptive_edges":true          // bounds-safe edge/thin-z context padding
    }
}

// Selected registrations. In centroid mode this is written automatically after the review
// pause; in legacy mode you paste the winner's path here yourself.
HCR_selected_registrations:{
    "rounds":[
       {"round":"02",
        "selected_registrations":["local_params_scan_nodeform/rz1_rxy25_bs2to20_mt0.3/bs100_100_25_1_25_bs5to50_mt0.2"]
        },
        {"round":"03",
        "selected_registrations":["local_params_scan_nodeform/rz1_rxy25_bs3to30_mt0.2/bs150_150_15_4_4_bs60to70_mt0.5"]
        }

    ]
}

// Write each FISH round warped into the reference frame, under
// OUTPUT/HCR/full_registered_stacks/. Off by default and read by nothing: probe
// intensities are measured on the acquired, un-warped rounds and matching runs on
// the aligned label volumes. Turn it on to look at the rounds superimposed, but
// treat the result as pictures -- warping resamples the signal, which is why
// quantification does not use it. Costs one warp per channel per round.
export_warped_rounds:false

// 2P -> HCR registration: commonly tuned knobs.
// Lower-tier params (RANSAC, FFT-IoU thresholds, coarse-match patches) are read
// from this same block but fall through to defaults if not specified.
twop_to_hcr_registration:{
    "cascade_stages":[400, 200, 100],   // strictly-decreasing tile sizes (px); default [300, 100, 50]
    "erosion":2,                        // 2P mask shrink (px); 0 for cp4-SAM masks
    "erosion_hcr":0,                    // HCR mask shrink (px); try 1 if HCR cells bleed
    "z_range_global":[-15, 15],         // z-offset search range (slices); widen to [-25, 25] for large z offset
    // "xy_max_global":100,             // xy search cap (px). Default 100. Tightened from 500 on
                                        // 2026-06-02: healthy planes shift 1-51 px, while broken
                                        // runs shifted 400-700 px onto a spurious dense cluster.
                                        // Raise only if a good alignment is being rejected.
    "hull_margin":-100,                 // inward hull erosion (px, negative); less negative (-50) for poor landmark coverage
    // Neighborhood-agreement term for each 2P->HCR match: the any-cell foreground
    // IoU in a window around the cell, REPORTED as twoP_neighborhood_iou in the
    // merged table alongside twoP_iou. It never drops matches — threshold it
    // yourself downstream (high candidate IoU + low neighborhood IoU flags a
    // spurious single-cell overlap in a partially-aligned region).
    "report_neighborhood_iou":true,     // set false to omit the column
    "neighborhood_window_px":50,        // XY window side length (px)
    // How the composed warp reaches the output labels. Default false pulls the label
    // image through the dense field, which scales every mask by 1/|det(I - grad d)| --
    // a side effect of resampling, not something the cascade measured, since the field
    // is interpolated from tile centres and carries no within-cell detail. true gives
    // each cell the field averaged over its own footprint and moves it by that one
    // vector, so area, aspect and connectivity survive. Alignment and scoring use the
    // dense field either way. Per-plane numbers in
    // easipass/processing_notebooks/cascade_distortion_cohort.csv.
    "rigid_output_masks":false          // true to translate masks instead of resampling them
}

// HCR round-to-round cell matching: a two-stage hybrid that re-pairs cells across
// rounds and fills round_{R}_hybrid_match in the merged table, which the gene columns
// are joined on. Stage 1 = best-plane IoU overlap (the well-registered bulk); stage 2 =
// pinned soma-print repair (recovers partners in locally mis-registered patches that
// overlap alone misses). The merged table gains round_{R}_hybrid_matched_by
// ('overlap'|'somaprint') and the soma score columns, alongside round_{R}_iou_match,
// which is what overlap alone would have said.
// Default ON; set enabled:false to fall back to pure IoU best-match.
// Validated on JS082 HCR02->HCR01 (81.4% overlap -> 88.2% hybrid).
somaprint_hcr:{
    "enabled":true
    // "overlap_tau":0.5      // min best-single-plane IoU to seed a stage-1 anchor
    // "search_xy_um":126.0   // soma candidate-box half-width (XY, microns)
    // "search_z_um":37.0     // soma candidate-box half-height (Z, microns)
    // "plane_band":2         // 2d_plane fingerprint: neighbours within +/-band planes
    // "lr_threshold":0.05    // soma gate likelihood-ratio threshold
}
